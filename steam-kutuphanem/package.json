{
  "name": "steam-kutuphanem",
  "productName": "Steam Kutuphanem",
  "version": "0.2.1",
  "description": "Kendi Steam kutuphane yoneticin: kurulu oyunlari listeler, kapaklarini gosterir, favori ve not tutar.",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "build-portable": "electron-builder --win portable"
  },
  "keywords": [
    "steam",
    "library",
    "electron",
    "kutuphane"
  ],
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "com.steamkutuphanem.app",
    "productName": "Steam Kutuphanem",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
